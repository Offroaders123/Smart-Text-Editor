{
  "name": "Smart Text Editor",
  "short_name": "Text Editor",
  "description": "The text editor that requires only a browser and a keyboard!",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "theme_color": "#1e1e1e",
  "background_color": "#1e1e1e",
  "icons": [
    {
      "src": "./img/app-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "./img/app-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "./img/app-1024.png",
      "type": "image/png",
      "sizes": "1024x1024"
    },
    {
      "src": "./img/app-maskable-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "./img/app-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "./img/app-maskable-1024.png",
      "type": "image/png",
      "sizes": "1024x1024",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/*": [".txt",".html",".css",".js",".json",".xml",".md"],
        "image/svg+xml": [".svg"]
      }
    }
  ]
}